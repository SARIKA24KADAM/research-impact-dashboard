        ],
        "partitions": [
          {
            "name": "kpi_definitions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/kpi_definitions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"KPIID\", type text}, {\"KPIName\", type text}, {\"Unit\", type text}, {\"Frequency\", type text}, {\"TargetDirection\", type text}, {\"DefaultTarget\", type text}, {\"Definition\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "budgets",
        "columns": [
          {
            "name": "BudgetID",
            "dataType": "string",
            "sourceColumn": "BudgetID",
            "summarizeBy": "none"
          },
          {
            "name": "ProjectID",
            "dataType": "string",
            "sourceColumn": "ProjectID",
            "summarizeBy": "none"
          },
          {
            "name": "FiscalYear",
            "dataType": "int64",
            "sourceColumn": "FiscalYear",
            "summarizeBy": "sum"
          },
          {
            "name": "ApprovedBudgetCAD",
            "dataType": "decimal",
            "sourceColumn": "ApprovedBudgetCAD",
            "summarizeBy": "sum",
            "formatString": "$#,##0;($#,##0);$#,##0"
          },
          {
            "name": "ApprovedDate",
            "dataType": "dateTime",
            "sourceColumn": "ApprovedDate",
            "summarizeBy": "none"
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "budgets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/budgets.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"BudgetID\", type text}, {\"ProjectID\", type text}, {\"FiscalYear\", Int64.Type}, {\"ApprovedBudgetCAD\", Currency.Type}, {\"ApprovedDate\", type date}, {\"Currency\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Approved Budget CAD",
            "expression": "SUM(budgets[ApprovedBudgetCAD])",
            "formatString": "$#,##0;($#,##0);$#,##0"
          },
          {
            "name": "Budget Remaining CAD",
            "expression": "[Approved Budget CAD] - [Actual Expenditure CAD]",
            "formatString": "$#,##0;($#,##0);$#,##0"
          },
          {
            "name": "Budget Utilization %",
            "expression": "DIVIDE([Actual Expenditure CAD], [Approved Budget CAD])",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "commitments",
        "columns": [
          {
            "name": "CommitmentID",
            "dataType": "string",
            "sourceColumn": "CommitmentID",
            "summarizeBy": "none"
          },
          {
            "name": "ProjectID",
            "dataType": "string",
            "sourceColumn": "ProjectID",
            "summarizeBy": "none"
          },
          {
