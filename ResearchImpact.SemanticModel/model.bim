          },
          {
            "name": "FiscalYear",
            "dataType": "int64",
            "sourceColumn": "FiscalYear",
            "summarizeBy": "sum"
          },
          {
            "name": "AmountCAD",
            "dataType": "decimal",
            "sourceColumn": "AmountCAD",
            "summarizeBy": "sum",
            "formatString": "$#,##0;($#,##0);$#,##0"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "expenditures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/expenditures.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"ExpenditureID\", type text}, {\"ProjectID\", type text}, {\"TransactionDate\", type date}, {\"FiscalYear\", Int64.Type}, {\"AmountCAD\", Currency.Type}, {\"Category\", type text}, {\"Status\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Actual Expenditure CAD",
            "expression": "CALCULATE(SUM(expenditures[AmountCAD]), expenditures[Status] = \"Posted\")",
            "formatString": "$#,##0;($#,##0);$#,##0"
          }
        ]
      },
      {
        "name": "kpi_actuals",
        "columns": [
          {
            "name": "ActualID",
