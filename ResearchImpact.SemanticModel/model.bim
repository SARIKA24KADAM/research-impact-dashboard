        "partitions": [
          {
            "name": "public_energy_context",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/public/global-data-on-sustainable-energy.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Canada = Table.SelectRows(Headers, each [Entity] = \"Canada\"),",
                "    Selected = Table.SelectColumns(Canada, {\"Entity\", \"Year\", \"Renewable energy share in the total final energy consumption (%)\"}),",
                "    Renamed = Table.RenameColumns(Selected, {{\"Entity\", \"Country\"}, {\"Renewable energy share in the total final energy consumption (%)\", \"RenewableShare\"}}),",
                "    Typed = Table.TransformColumnTypes(Renamed, {{\"Country\", type text}, {\"Year\", Int64.Type}, {\"RenewableShare\", type number}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
