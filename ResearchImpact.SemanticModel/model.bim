                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"OutputID\", type text}, {\"ProjectID\", type text}, {\"OutputType\", type text}, {\"Title\", type text}, {\"PublicationDate\", type date}, {\"PeerReviewed\", type text}, {\"Status\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
