            "dataType": "string",
            "sourceColumn": "FunderName",
            "summarizeBy": "none"
          },
          {
            "name": "CommitmentDate",
            "dataType": "dateTime",
            "sourceColumn": "CommitmentDate",
            "summarizeBy": "none"
          },
          {
            "name": "AmountCAD",
            "dataType": "decimal",
            "sourceColumn": "AmountCAD",
            "summarizeBy": "sum",
            "formatString": "$#,##0;($#,##0);$#,##0"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "commitments",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/commitments.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"CommitmentID\", type text}, {\"ProjectID\", type text}, {\"FunderName\", type text}, {\"CommitmentDate\", type date}, {\"AmountCAD\", Currency.Type}, {\"Status\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Active Commitments CAD",
            "expression": "CALCULATE(SUM(commitments[AmountCAD]), commitments[Status] = \"Active\")",
            "formatString": "$#,##0;($#,##0);$#,##0"
          }
        ]
      },
      {
        "name": "expenditures",
