{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-CA",
    "sourceQueryCulture": "en-CA",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "discourageImplicitMeasures": false,
    "annotations": [],
    "expressions": [],
    "functions": [],
    "perspectives": [],
    "roles": [],
    "relationships": [
      {
        "name": "Projects_Themes",
        "fromTable": "projects",
        "fromColumn": "ThemeID",
        "toTable": "themes",
        "toColumn": "ThemeID",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "Projects_Owners",
        "fromTable": "projects",
        "fromColumn": "OwnerID",
        "toTable": "owners",
        "toColumn": "OwnerID",
