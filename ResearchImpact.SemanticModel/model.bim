          },
          {
            "name": "IsFictional",
            "dataType": "boolean",
            "sourceColumn": "IsFictional",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "kpi_actuals",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/kpi_actuals.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"ActualID\", type text}, {\"ProjectID\", type text}, {\"KPIID\", type text}, {\"PeriodStart\", type date}, {\"PeriodEnd\", type date}, {\"ActualValue\", type number}, {\"TargetValue\", type number}, {\"SubmissionStatus\", type text}, {\"IsFictional\", type logical}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Average KPI Actual",
            "expression": "AVERAGE(kpi_actuals[ActualValue])",
            "formatString": "0.0"
          },
          {
            "name": "Prototype Readiness",
            "expression": "CALCULATE(AVERAGE(kpi_actuals[ActualValue]), kpi_actuals[KPIID] = \"K01\")",
            "formatString": "0.0"
          }
        ]
      },
