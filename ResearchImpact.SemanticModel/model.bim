        ],
        "partitions": [
          {
            "name": "reporting_obligations",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/reporting_obligations.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"ObligationID\", type text}, {\"ProjectID\", type text}, {\"ReportingPeriodEnd\", type date}, {\"DueDate\", type date}, {\"ReceivedDate\", type date}, {\"Status\", type text}, {\"ReportingType\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Expected Reports",
            "expression": "COUNTROWS(reporting_obligations)",
            "formatString": "#,##0"
          },
          {
            "name": "On-time Reports",
            "expression": "CALCULATE(COUNTROWS(reporting_obligations), reporting_obligations[Status] = \"On Time\")",
            "formatString": "#,##0"
          },
          {
            "name": "On-time Reporting %",
            "expression": "DIVIDE([On-time Reports], [Expected Reports])",
            "formatString": "0.0%"
          }
        ]
      },
