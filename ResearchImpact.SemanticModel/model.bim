        "toColumn": "RiskID",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      }
    ],
    "tables": [
      {
        "name": "themes",
        "columns": [
          {
            "name": "ThemeID",
            "dataType": "string",
            "sourceColumn": "ThemeID",
            "summarizeBy": "none"
          },
          {
            "name": "ThemeName",
            "dataType": "string",
            "sourceColumn": "ThemeName",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "themes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/themes.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"ThemeID\", type text}, {\"ThemeName\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "owners",
        "columns": [
          {
            "name": "OwnerID",
            "dataType": "string",
            "sourceColumn": "OwnerID",
            "summarizeBy": "none"
          },
          {
            "name": "OwnerName",
            "dataType": "string",
            "sourceColumn": "OwnerName",
            "summarizeBy": "none"
          },
          {
            "name": "Role",
            "dataType": "string",
            "sourceColumn": "Role",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "owners",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/owners.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"OwnerID\", type text}, {\"OwnerName\", type text}, {\"Role\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "projects",
        "columns": [
          {
            "name": "ProjectID",
            "dataType": "string",
            "sourceColumn": "ProjectID",
            "summarizeBy": "none"
          },
          {
            "name": "ProjectName",
            "dataType": "string",
            "sourceColumn": "ProjectName",
            "summarizeBy": "none"
          },
          {
            "name": "ThemeID",
            "dataType": "string",
            "sourceColumn": "ThemeID",
            "summarizeBy": "none"
          },
          {
            "name": "OwnerID",
            "dataType": "string",
            "sourceColumn": "OwnerID",
            "summarizeBy": "none"
          },
          {
            "name": "StartDate",
            "dataType": "dateTime",
            "sourceColumn": "StartDate",
            "summarizeBy": "none"
          },
          {
            "name": "PlannedEndDate",
            "dataType": "dateTime",
            "sourceColumn": "PlannedEndDate",
            "summarizeBy": "none"
          },
          {
            "name": "ProjectStatus",
            "dataType": "string",
            "sourceColumn": "ProjectStatus",
            "summarizeBy": "none"
          },
          {
            "name": "Priority",
            "dataType": "string",
            "sourceColumn": "Priority",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "projects",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/SARIKA24KADAM/research-impact-dashboard/main/data/synthetic/projects.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"ProjectID\", type text}, {\"ProjectName\", type text}, {\"ThemeID\", type text}, {\"OwnerID\", type text}, {\"StartDate\", type date}, {\"PlannedEndDate\", type date}, {\"ProjectStatus\", type text}, {\"Priority\", type text}}, \"en-CA\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Active Projects",
            "expression": "CALCULATE(DISTINCTCOUNT(projects[ProjectID]), projects[ProjectStatus] = \"Active\")",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "kpi_definitions",
        "columns": [
          {
            "name": "KPIID",
            "dataType": "string",
            "sourceColumn": "KPIID",
            "summarizeBy": "none"
          },
          {
            "name": "KPIName",
